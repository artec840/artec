local KORBLOX_PARTS = { "RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg" }

local function applyFakeKorblox(char)
    if not char then return end
    pcall(function()
        for _, name in ipairs(KORBLOX_PARTS) do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") then part.Transparency = 1 end
        end
    end)
end

local function removeFakeKorblox(char)
    if not char then return end
    pcall(function()
        for _, name in ipairs(KORBLOX_PARTS) do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") then part.Transparency = 0 end
        end
    end)
end

local function applyFakeHeadless(char)
    if not char then return end
    pcall(function()
        local head = char:FindFirstChild("Head")
        if head then
            head.Transparency = 1
            for _, child in pairs(head:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then child.Transparency = 1 end
            end
        end
        for _, acc in pairs(char:GetChildren()) do
            if acc:IsA("Accessory") then
                local handle = acc:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    local isHeadAcc = false
                    for _, child in pairs(handle:GetChildren()) do
                        if child:IsA("Attachment") then
                            local aName = string.lower(child.Name)
                            if string.find(aName, "hat") or string.find(aName, "hair")
                            or string.find(aName, "face") or string.find(aName, "head") then
                                isHeadAcc = true; break
                            end
                        end
                    end
                    if not isHeadAcc then
                        for _, weld in pairs(handle:GetChildren()) do
                            if weld:IsA("Weld") or weld:IsA("Motor6D") or weld:IsA("WeldConstraint") then
                                if weld.Part0 == head or weld.Part1 == head then isHeadAcc = true; break end
                            end
                        end
                    end
                    if isHeadAcc or acc.AccessoryType == Enum.AccessoryType.Hat 
                    or acc.AccessoryType == Enum.AccessoryType.Hair 
                    or acc.AccessoryType == Enum.AccessoryType.Face then
                        handle.Transparency = 1
                        for _, sub in pairs(handle:GetDescendants()) do
                            if sub:IsA("BasePart") or sub:IsA("MeshPart")
                            or sub:IsA("Decal") or sub:IsA("Texture") then
                                sub.Transparency = 1
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function removeFakeHeadless(char)
    if not char then return end
    pcall(function()
        local head = char:FindFirstChild("Head")
        if head then
            head.Transparency = 0
            for _, child in pairs(head:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then child.Transparency = 0 end
            end
        end
        for _, acc in pairs(char:GetChildren()) do
            if acc:IsA("Accessory") then
                local handle = acc:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    handle.Transparency = 0
                    for _, sub in pairs(handle:GetDescendants()) do
                        if sub:IsA("BasePart") or sub:IsA("MeshPart")
                        or sub:IsA("Decal") or sub:IsA("Texture") then
                            sub.Transparency = 0
                        end
                    end
                end
            end
        end
    end)
end

local function trackProperty(obj, prop, val)
    pcall(function()
        local alreadyTracked = false
        for _, item in ipairs(savedProps) do
            if item.obj == obj and item.prop == prop then
                alreadyTracked = true
                break
            end
        end
        if not alreadyTracked then
            table.insert(savedProps, {obj = obj, prop = prop, val = obj[prop]})
            obj[prop] = val
        end
    end)
end

local function stripObjectAdvanced(obj)
    pcall(function()
        if obj:IsA("BasePart") then
            if obj.CastShadow then trackProperty(obj, "CastShadow", false) end
            if obj.Material ~= Enum.Material.SmoothPlastic then trackProperty(obj, "Material", Enum.Material.SmoothPlastic) end
            
            for _, child in pairs(obj:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    if child.Transparency < 1 then trackProperty(child, "Transparency", 1) end
                end
            end
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Light") then
            if obj.Enabled then trackProperty(obj, "Enabled", false) end
        elseif obj:IsA("Accessory") then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                if handle.Transparency < 1 then trackProperty(handle, "Transparency", 1) end
                for _, child in pairs(handle:GetDescendants()) do
                    if (child:IsA("BasePart") or child:IsA("Decal") or child:IsA("Texture")) and child.Transparency < 1 then
                        trackProperty(child, "Transparency", 1)
                    end
                end
            end
        end
    end)
end

local function enableAdvancedFps()
    pcall(function()
        savedQuality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    savedLighting = {
        GlobalShadows = Lighting.GlobalShadows,
        EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
    }

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sky") then
                if obj.Enabled then trackProperty(obj, "Enabled", false) end
            end
        end
    end)

    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            trackProperty(terrain, "WaterWaveSize", 0)
            trackProperty(terrain, "WaterWaveSpeed", 0)
            trackProperty(terrain, "DecorationEnabled", false)
        end
    end)

    for _, obj in ipairs(Workspace:GetDescendants()) do
        stripObjectAdvanced(obj)
    end

    if connections[1] then connections[1]:Disconnect() end
    connections[1] = Workspace.DescendantAdded:Connect(function(obj)
        if fpsBoostEnabled then stripObjectAdvanced(obj) end
    end)

    pcall(function() if setfpscap then setfpscap(240) end end)
end

local function disableAdvancedFps()
    pcall(function()
        if savedQuality then settings().Rendering.QualityLevel = savedQuality end
        if savedLighting then
            Lighting.GlobalShadows = savedLighting.GlobalShadows
            Lighting.EnvironmentDiffuseScale = savedLighting.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = savedLighting.EnvironmentSpecularScale
        end
    end)

    for _, item in ipairs(savedProps) do
        pcall(function()
            if item.obj and item.obj.Parent then
                item.obj[item.prop] = item.val
            end
        end)
    end
    table.clear(savedProps)

    if connections[1] then connections[1]:Disconnect() connections[1] = nil end

    pcall(function() if setfpscap then setfpscap(0) end end)
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if korbloxEnabled  then applyFakeKorblox(char)  end
    if headlessEnabled then applyFakeHeadless(char) end
    if fpsBoostEnabled then
        for _, obj in ipairs(char:GetDescendants()) do stripObjectAdvanced(obj) end
    end
end)

